{
  "name": "ventasbv",
  "version": "1.0.0",
  "description": "Sistema de Gestion Comercial VentasBV",
  "author": "VentasBV",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "typecheck": "tsc --pretty false",
    "electron:dev": "concurrently \"vite\" \"wait-on tcp:5173 && cross-env NODE_ENV=development electron .\"",
    "dist:win": "tsc && vite build && electron-packager . VentasBV --platform=win32 --arch=x64 --out=release --overwrite --prune=true --icon=electron/icon.ico",
    "dist:installer": "npm run dist:win && node build-installer.cjs"
  },
  "build": {
    "appId": "com.ventasbv.pos",
    "productName": "VentasBV - Sistema de Gestion Comercial",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "VentasBV"
    }
  },
  "dependencies": {
    "@fontsource-variable/chivo": "5.2.8",
    "@fontsource/ibm-plex-mono": "5.2.7",
    "@fontsource/ibm-plex-sans": "5.2.8",
    "@hookform/resolvers": "3.10.0",
    "@supabase/supabase-js": "^2.112.3",
    "@tanstack/react-query": "5.101.2",
    "@types/qrcode": "^1.5.6",
    "clsx": "^2.1.1",
    "exceljs": "^4.4.0",
    "html2pdf.js": "^0.14.0",
    "lucide-react": "0.471.0",
    "qrcode": "^1.5.4",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-hook-form": "7.54.2",
    "react-router-dom": "7.1.1",
    "socket.io-client": "4.8.1",
    "sweetalert2": "^11.26.25",
    "tailwind-merge": "^2.6.0",
    "xlsx": "^0.18.5",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "22.10.5",
    "@types/react": "19.0.4",
    "@types/react-dom": "19.0.2",
    "@vitejs/plugin-react": "4.3.4",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "electron": "^31.7.7",
    "electron-builder": "^26.15.3",
    "electron-winstaller": "^5.4.4",
    "jimp": "^1.6.1",
    "png-to-ico": "^3.0.2",
    "tailwindcss": "^4.3.3",
    "typescript": "5.7.3",
    "vite": "6.0.7",
    "wait-on": "^9.1.0"
  }
}
